{
  "manifest_version": 2,
  "name": "ReadIN 译读",
  "version": "0.9.0",
  "description": "Read your papers in ReadIN, then send highlights and notes back. 在 ReadIN 里读论文，高亮和笔记送回文献库。",
  "homepage_url": "https://readin.cc",
  "author": "Anqa Labs",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "yidu@readin.cc",
      "update_url": "https://readin.cc/yidu/update.json",
      "strict_min_version": "9.0",
      "strict_max_version": "10.*"
    }
  }
}
